PORT=1234
GIN_MODE=debug

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=ecommerce
DB_SSLMODE=disable

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=72h

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY_ID=test
AWS_S3_BUCKET=ecommerce-uploads
AWS_S3_ENDPOINT=http://127.0.0.1:4566

UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760 #100MB
UPLOAD_STORAGE=local ## use local or aws, depending on your usecase

COMPANY_DOMAIN=example.com
ADMIN_CODE=example_admin
